# ========================================
# KiraAI Environment Variables Template
# ========================================
# このファイルを .env にコピーして使用してください
# cp .env.example .env

# ========================================
# General Settings
# ========================================
APP_NAME=KiraAI
APP_ENV=development  # development, staging, production
DEBUG=true

# ========================================
# Backend API Settings
# ========================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true  # 開発時のみtrue

# ========================================
# Frontend Settings
# ========================================
FRONTEND_PORT=3000
VITE_API_BASE_URL=http://localhost:8000/api

# ========================================
# Database (PostgreSQL)
# ========================================
POSTGRES_USER=kiraai_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=kiraai_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ========================================
# Redis
# ========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# ========================================
# JWT Authentication
# ========================================
# 以下のコマンドで生成してください: openssl rand -hex 32
JWT_SECRET_KEY=your_jwt_secret_key_here_please_change_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ========================================
# Anthropic Claude API
# ========================================
# https://console.anthropic.com/account/keys から取得
CLAUDE_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
CLAUDE_MODEL_SONNET=claude-sonnet-4-5-20250929
CLAUDE_MODEL_HAIKU=claude-haiku-4-5-20251001
CLAUDE_MAX_TOKENS=4096
CLAUDE_TEMPERATURE=0.7

# ========================================
# JSearch API (RapidAPI)
# ========================================
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch で取得
INDEED_PUBLISHER_ID=your_rapidapi_key_here
INDEED_API_URL=https://jsearch.p.rapidapi.com

# ========================================
# Careerjet API (Japanese job aggregator)
# ========================================
# https://www.careerjet.com/partners/ で登録
CAREERJET_AFFID=your_careerjet_affid_here

# ========================================
# File Storage
# ========================================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_EXTENSIONS=pdf,docx,jpg,jpeg,png

# ========================================
# Email (Optional - Phase 2以降)
# ========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=noreply@kiraai.com

# ========================================
# CORS Settings
# ========================================
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOW_HEADERS=*

# ========================================
# Rate Limiting
# ========================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# ========================================
# Logging
# ========================================
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # json or text

# ========================================
# Security
# ========================================
# 本番環境では必ず true に設定
SECURE_COOKIES=false
HTTPS_ONLY=false

# ========================================
# External APIs (Phase 2以降)
# ========================================
# OpenWork API (企業クチコミ)
# OPENWORK_API_KEY=

# リクナビNEXT / マイナビ / doda (RPA認証情報)
# RIKUNABI_USERNAME=
# RIKUNABI_PASSWORD=
# MYNAVI_USERNAME=
# MYNAVI_PASSWORD=
# DODA_USERNAME=
# DODA_PASSWORD=
